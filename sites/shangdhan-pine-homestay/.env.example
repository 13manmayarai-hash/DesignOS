# Copy this file to .env.local for local development, and set the same
# values in your deploy host's environment variables settings (Vercel:
# Project -> Settings -> Environment Variables) for the deployed site.
# See README.md: "Backend setup" and "Booking".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional -- only needed for booking confirmation emails. Leave unset and
# /book still works fine, it just won't email guests a confirmation.
RESEND_API_KEY=
